{
  "name": "dsh-session-cleaner-thao712",
  "version": "1.4.0",
  "type": "module",
  "description": "Preview and permanently delete archived DeepSeek Harness Sessions, per-conversation folders, attachments, workspace files, and orphan conversation folders.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THao712/dsh-session-cleaner.git"
  },
  "homepage": "https://github.com/THao712/dsh-session-cleaner#readme",
  "bugs": {
    "url": "https://github.com/THao712/dsh-session-cleaner/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "session-cleanup",
    "session-archive",
    "conversation-folder",
    "orphan-cleanup",
    "session"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
